# For local development, DATABASE_URL defaults to ./common_dev.sqlite3
DATABASE_URL=sqlite:////absolute/path/to/common_dev.sqlite3
# In production set this to the exact https:// origin of the website.
PUBLIC_ORIGIN=http://localhost:8000
# REQUIRED when running behind HTTPS in a production environment
SECURE_COOKIES=false
# Disable API docs in public production deployments
ENABLE_API_DOCS=true

# Contact-identified SEC EDGAR public-company research (optional)
# SEC_USER_AGENT=COMMON Research your-contact@your-domain.example
